# ── مدير الإعدادات (يُتحقق منه في Netlify Function فقط) ──────────
SETTINGS_ADMIN_ACCOUNT=+249XXXXXXXXX
SETTINGS_ADMIN_PIN=CHANGE_ME_STRONG_PIN

# ── JWT والتشفير ──────────────────────────────────────────────────
SETTINGS_SESSION_SECRET=MINIMUM_32_RANDOM_CHARS_CHANGE_THIS_NOW
AUTH_PASSWORD_PEPPER=ANOTHER_RANDOM_32_CHAR_STRING_FOR_PASSWORDS
AUTH_OTP_SECRET=RANDOM_32_CHAR_STRING_FOR_OTP_HMAC

# ── اتصال Apps Script ──────────────────────────────────────────────
APPS_SCRIPT_URL=https://script.google.com/macros/s/PASTE_YOUR_DEPLOYMENT_ID/exec
APPS_SCRIPT_SHARED_SECRET=strong-shared-secret-between-netlify-and-gas

# ── CORS ──────────────────────────────────────────────────────────
ALLOWED_ORIGIN=https://your-site.netlify.app

# ── WhatsApp (اختياري — OTP والإشعارات) ──────────────────────────
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_ADMIN_PHONE=+249XXXXXXXXX

# ── Google Apps Script ─────────────────────────────────────────
# رابط Apps Script Web App (بعد النشر كـ Web App)
APPS_SCRIPT_API_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# سر مشترك يتحقق منه Apps Script للتأكد أن الطلب من Netlify Function
APPS_SCRIPT_API_SECRET=your-strong-random-secret-here

# ── حساب المدير الأساسي ─────────────────────────────────────────
# رقم المدير بالصيغة الدولية
ADMIN_PHONE=+249918251171
# كلمة المرور الأولية — يُجبَر المدير على تغييرها عند أول دخول
ADMIN_INITIAL_PASSWORD=CHANGE_ME_ON_FIRST_LOGIN
# دور المدير
ADMIN_ROLE=super_admin

# ── WhatsApp Cloud API ──────────────────────────────────────────
# رقم WhatsApp الإداري (يستقبل إشعارات الموافقة)
WHATSAPP_ADMIN_PHONE=+249918251171
# من Facebook Developer Console → WhatsApp → API Setup
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id
# Access Token الدائم (Generated from System User)
WHATSAPP_ACCESS_TOKEN=your_permanent_access_token
# رمز التحقق للـ Webhook (تختاره أنت عشوائياً)
WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token

# ── الأمان ─────────────────────────────────────────────────────
# سر التوقيع على JWT (على الأقل 64 حرفاً عشوائياً)
JWT_SECRET=replace-with-64-char-random-string-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# فلفل كلمات المرور (يُضاف للـ PBKDF2 ويُخزَّن هنا فقط)
PASSWORD_PEPPER=replace-with-another-64-char-random-string

# سر تشفير OTP
OTP_SECRET=replace-with-otp-secret-string

# سر الجلسة (للتوقيع)
SESSION_SECRET=replace-with-session-secret

# ── CORS ────────────────────────────────────────────────────────
# نطاق موقعك على Netlify (بدون / في النهاية)
ALLOWED_ORIGIN=https://your-site.netlify.app
